#!/usr/bin/env bash
# gatesmith-acceptance — Deterministic acceptance ledger runner (GAP-7)
#
# Runs metamorphic relations and frozen cases from a product's acceptance/
# directory against its black-box CLI. No LLM, no network, zero tokens, except
# `oracle` (below), the one subcommand that calls a model.
# Every entry starts advisory. `promote` (increment 2b) moves one to
# required, recording that it earned the tier: it refuses unless the last
# recorded run was on main, the entry passed on that run, AND the mutant
# canary (increment 2c) reports it caught its mutant.
#
# NO entry blocks anything yet, required included: a run still exits 0 with
# divergences reported. Enforcement — a required entry failing the run —
# arrives in a later increment. `promote` earns the tier; it does not arm it.
#
# Usage:
#   gatesmith-acceptance run [--project-dir PATH] [--junit PATH]
#   gatesmith-acceptance status [--project-dir PATH]
#   gatesmith-acceptance promote --entry-id ID [--project-dir PATH]
#   gatesmith-acceptance canary --artifact PATH [--project-dir PATH] [--max-mutants N]
#   gatesmith-acceptance harvest [--project-dir PATH]
#   gatesmith-acceptance confirm [--project-dir PATH]
#   gatesmith-acceptance corpus-status [--project-dir PATH]
#   gatesmith-acceptance oracle [--dry-run | --provider-cmd CMD] [--project-dir PATH]
#   gatesmith-acceptance divergences [--project-dir PATH]
#
# Exit codes:
#   0  Run completed (no entry fails the run in this increment); or promote
#      succeeded; or `divergences` updated the register
#   1  The ledger could not be loaded, `status` found no prior run, or
#      `promote` was refused (message names the file and the condition);
#      `oracle` whose claims, blind export or provider could not be built,
#      or (adjudication) in which no session cast a vote on any claim;
#      `divergences` whose run records or entry files could not be read
#
# `divergences` (LEDGER-5a) folds the last run (last_run.json and the last
# line of runs.jsonl) into .company/state/acceptance/divergences.json, one
# record per entry id, and lists the open ones, required tier first. It
# records; it blocks nothing and changes no verdict or exit code a gate reads.
#
# `oracle` (LEDGER-4b) sends each claim to a quorum of model sessions that see
# only the spec and the claim, and appends the result to
# .company/state/acceptance/proposals.jsonl. A proposal is never a verdict: it
# changes no divergence, no tier and no exit code a gate reads. --dry-run lists
# the claims and the blind export and calls no model.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND="${SCRIPT_DIR}/.claude/hooks/company/acceptance_ledger.py"
CANARY_BACKEND="${SCRIPT_DIR}/.claude/hooks/company/acceptance_canary.py"
CORPUS_BACKEND="${SCRIPT_DIR}/.claude/hooks/company/acceptance_corpus.py"
PROBE_BACKEND="${SCRIPT_DIR}/.claude/hooks/company/acceptance_probe.py"
DIVERGENCES_BACKEND="${SCRIPT_DIR}/.claude/hooks/company/acceptance_divergences.py"

if [ ! -f "$BACKEND" ]; then
    echo "Error: acceptance_ledger.py not found at ${BACKEND}" >&2
    exit 1
fi

case "${1:-}" in
    --help|-h|help)
        head -45 "$0" | tail -44
        exit 0
        ;;
    canary)
        if [ ! -f "$CANARY_BACKEND" ]; then
            echo "Error: acceptance_canary.py not found at ${CANARY_BACKEND}" >&2
            exit 1
        fi
        exec python3 "$CANARY_BACKEND" "$@"
        ;;
    harvest|confirm|corpus-status)
        if [ ! -f "$CORPUS_BACKEND" ]; then
            echo "Error: acceptance_corpus.py not found at ${CORPUS_BACKEND}" >&2
            exit 1
        fi
        exec python3 "$CORPUS_BACKEND" "$@"
        ;;
    oracle)
        if [ ! -f "$PROBE_BACKEND" ]; then
            echo "Error: acceptance_probe.py not found at ${PROBE_BACKEND}" >&2
            exit 1
        fi
        exec python3 "$PROBE_BACKEND" "$@"
        ;;
    divergences)
        if [ ! -f "$DIVERGENCES_BACKEND" ]; then
            echo "Error: acceptance_divergences.py not found at ${DIVERGENCES_BACKEND}" >&2
            exit 1
        fi
        exec python3 "$DIVERGENCES_BACKEND" "$@"
        ;;
    *)
        exec python3 "$BACKEND" "$@"
        ;;
esac
