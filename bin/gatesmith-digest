#!/usr/bin/env bash
# gatesmith-digest — one read-only morning digest across every Gatesmith project
#
# Usage:
#   gatesmith-digest                      # all projects with a dev.gatesmith.daemon.* LaunchAgent
#   gatesmith-digest --project DIR ...    # only these project directories
#   gatesmith-digest --save               # also write <first project>/.company/reports/digest-YYYY-MM-DD.md
#   gatesmith-digest --notify             # also send ONE macOS notification with the summary line
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DIGEST="${SCRIPT_DIR}/.claude/hooks/company/operator_digest.py"

if [ ! -f "$DIGEST" ]; then
    echo "Error: operator_digest.py not found at ${DIGEST}" >&2
    exit 1
fi

case "${1:-}" in
    help|--help|-h)
        head -10 "$0" | tail -8
        ;;
    *)
        exec uv run "$DIGEST" "$@"
        ;;
esac
