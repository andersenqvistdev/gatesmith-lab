#!/usr/bin/env bash
# gatesmith-queue — Gatesmith Labs work queue monitor
#
# Usage:
#   gatesmith-queue              # One-shot status
#   gatesmith-queue watch        # Live refresh (5s default)
#   gatesmith-queue watch 10     # Live refresh every 10s
#   gatesmith-queue --wide       # Full titles on one line (for piping); also `watch --wide`
#   gatesmith-queue results      # Task outcomes (last 10)
#   gatesmith-queue results --id task-20260707112436-61ab3e  # Detail view
#   gatesmith-queue heal         # Auto-fix queue issues
#   gatesmith-queue heal --dry   # Preview fixes without applying (--dry-run and -n also accepted)
#   gatesmith-queue json         # Machine-readable JSON output
#   gatesmith-queue prs          # List all tasks with PRs
#   gatesmith-queue follow <id>  # Trace task: queue → worker log → PR
#   gatesmith-queue rejections   # Admission rejections log (--limit N)
#   gatesmith-queue approvals    # List pending idea approvals (id, title, value, age)
#   gatesmith-queue approve <id> # Approve a pending idea by ID
#   gatesmith-queue approve --all # Approve all pending ideas
#   gatesmith-queue audit <PR#>  # Print merge audit chain for a PR number or task-id
#   gatesmith-queue cancel <id> --reason "..." [--keep-pr] [--dry-run]
#                            # End a task for good: stop its worker, close its PR
#   gatesmith-queue hold <id> --reason "..."   # Park in blocked; no sweep releases it
#   gatesmith-queue unhold <id>  # Clear an operator hold, back to pending
#   gatesmith-queue external add "<title>" [--branch B] [--pr N] [--owner O] [--note T]
#                            # Register work outside the daemon queue; prints its id
#   gatesmith-queue external update <id> [--status S] [--pr N] [--branch B] [--note T]
#   gatesmith-queue external done <id> [--note T]
#   gatesmith-queue external list [--all]   # --all also shows done/abandoned >24h old
#   gatesmith-queue help         # Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MONITOR="${SCRIPT_DIR}/.claude/hooks/company/queue_monitor.py"
RESULTS="${SCRIPT_DIR}/.claude/hooks/company/result_viewer.py"
FOLLOWER="${SCRIPT_DIR}/.claude/hooks/company/task_follower.py"
REJECTIONS="${SCRIPT_DIR}/.claude/hooks/company/rejection_viewer.py"
APPROVALS="${SCRIPT_DIR}/.claude/hooks/company/approval_viewer.py"
AUDIT="${SCRIPT_DIR}/.claude/hooks/company/merge_audit_viewer.py"

if [ ! -f "$MONITOR" ]; then
    echo "Error: queue_monitor.py not found at ${MONITOR}" >&2
    exit 1
fi

case "${1:-}" in
    watch|w)
        shift
        interval=5
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
            interval="$1"
            shift
        fi
        exec uv run "$MONITOR" --watch "$interval" "$@"
        ;;
    heal|fix)
        # A heal MUTATES the queue. An unrecognised flag must never fall
        # through to the mutating form: on 2026-09-04 `heal --dry-run`
        # (the flag queue_monitor itself uses) was silently run as a real
        # heal, 16 actions applied, because only --dry and -n were checked.
        case "${2:-}" in
            "")
                exec uv run "$MONITOR" --heal
                ;;
            --dry|--dry-run|-n)
                exec uv run "$MONITOR" --heal --dry-run
                ;;
            *)
                echo "gatesmith-queue heal: unknown option '${2}' (use --dry, --dry-run or -n to preview)" >&2
                exit 2
                ;;
        esac
        ;;
    json|j)
        exec uv run "$MONITOR" --json
        ;;
    prs|p)
        shift
        exec uv run "$MONITOR" --prs "$@"
        ;;
    results|r)
        shift
        exec uv run "$RESULTS" "$@"
        ;;
    follow|f)
        shift
        exec uv run "$FOLLOWER" "$@"
        ;;
    rejections|reject)
        shift
        exec uv run "$REJECTIONS" "$@"
        ;;
    approvals)
        exec uv run "$APPROVALS"
        ;;
    approve)
        shift
        exec uv run "$APPROVALS" approve "$@"
        ;;
    audit|a)
        shift
        exec uv run "$AUDIT" "$@"
        ;;
    cancel|hold|unhold|external)
        exec uv run "$MONITOR" "$@"
        ;;
    help|--help|-h)
        head -30 "$0" | tail -27
        ;;
    *)
        exec uv run "$MONITOR" "$@"
        ;;
esac
